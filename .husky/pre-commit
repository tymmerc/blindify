# Avant chaque commit, sur la machine du developpeur (la CI refait tout).
# 1. Aucun fichier .env reel dans l'index : ils contiennent les secrets.
#    .gitignore les exclut deja, mais `git add -f` passe outre.
#    "|| true" : husky lance ce script en sh -e, et grep sans resultat
#    renvoie 1, ce qui arretait tout commit.
env_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' || true)
if [ -n "$env_files" ]; then
  echo "Commit refuse : fichier .env (secrets) dans l'index :" >&2
  echo "$env_files" >&2
  echo "Retire-le avec : git restore --staged <fichier>" >&2
  exit 1
fi

# 2. ESLint sur les seuls fichiers indexes, avec la config de leur projet
#    (frontend/.lintstagedrc.json, backend/.lintstagedrc.json).
npx lint-staged
