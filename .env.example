# PostgreSQL connection
DATABASE_URL=postgres://blindify:blindify_pass@db:5432/blindify

# Spotify API credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://tymmerc.eu/blindify/api/auth/callback

# Frontend URL (for CORS + redirects)
FRONTEND_URL=https://tymmerc.eu/blindify

# Public backend URL (for OAuth redirect defaults)
PUBLIC_BACKEND_URL=https://tymmerc.eu/blindify

# JWT secret
JWT_SECRET=change_this_secret
SESSION_SECRET=change_this_secret
COOKIE_DOMAIN=.tymmerc.eu
COOKIE_SECURE=true

# Backend config
NODE_ENV=production
PORT=3000
