# Connection string for Postgres
DATABASE_URL=postgres://blindify:your_password@localhost:5432/blindify?sslmode=disable

# Spotify API OAuth credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://yourdomain.com/api/auth/callback

# Frontend URL (for CORS + redirects)
FRONTEND_URL=https://yourdomain.com

# Public backend URL (for OAuth redirect defaults)
PUBLIC_BACKEND_URL=https://yourdomain.com

# Secret keys for signing JWT tokens and sessions
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# Cookie configuration
COOKIE_DOMAIN=.yourdomain.com
COOKIE_SECURE=true

# Redis configuration (for game state management)
REDIS_URL=redis://localhost:6379

# Monitoring (optional)
SENTRY_DSN=your_sentry_dsn_here

# Runtime environment for the backend
NODE_ENV=production

# Port the backend server listens on
PORT=3000
