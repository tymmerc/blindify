# Environment
.env
.env.*
!.env.example

# Dependencies & builds
node_modules/
dist/
.next/
out/
out_backup/
tmp/
*.log
.DS_Store

# Build artifacts & caches
frontend/.config/
frontend/~/
frontend/post-export.sh
frontend/test-build.cjs
frontend/test-build.mjs

# Cache npx de shadcn commite par erreur le 16/01/2026 (1 325 fichiers, 83 alertes
# Dependabot sans rapport avec l'app) : il reste sur le disque, hors du depot.
frontend/.npm-cache-shadcn/

# Node.js local install (headers cause GitHub to detect C)
frontend/.node/
e2e-dashboard/node_modules/

# Test artifacts
frontend/playwright-report/
frontend/test-results/
frontend/e2e/*.zip

# Secret local de bypass des rate-limits pour E2E
.e2e-bypass-key
maquettes/shots/

# Lien vers les modules du frontend, pour la resolution des outils E2E
tools/node_modules
tools/test-stack/node_modules

# Pile de test locale (front de test, extraits synthetiques, journaux)
.test-stack/

# Docs internes (manuels d'agent, audits, plans) : elles restent sur le serveur,
# hors du depot public. Seul le README est publie.
*.md
!/README.md
