{
  "name": "blindify-backend",
  "version": "1.0.0",
  "description": "Backend API pour Blindify - Blind test musical",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "init-db": "node init-db.mjs",
    "lint": "eslint src --ext .ts",
