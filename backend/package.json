    "spotify",
    "blind-test",
    "music",
    "game"
  ],
  "author": "Blindify Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cookie-session": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-slow-down": "^2.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.2",
    "pg": "^8.11.3",
    "querystring": "^0.2.1",
    "socket.io": "^4.6.1",
    "spotify-preview-finder": "^2.1.0",
    "spotify-web-api-node": "^5.0.2",
    "winston": "^3.19.0"
