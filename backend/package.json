{
  "name": "blindify-backend",
  "version": "1.0.0",
  "description": "Backend API pour Blindify - Blind test musical",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "init-db": "node init-db.mjs",
    "lint": "eslint . --max-warnings=99",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns /integration/",
    "test:db": "bash scripts/test-db.sh up",
    "test:db:down": "bash scripts/test-db.sh down"
  },
  "keywords": [
    "blindify",
    "spotify",
    "blind-test",
    "music",
    "game"
  ],
  "author": "Blindify Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cookie-session": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-slow-down": "^2.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.2",
    "pg": "^8.23.1",
    "querystring": "^0.2.1",
    "socket.io": "^4.8.4",
    "spotify-web-api-node": "^5.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-slow-down": "^1.3.5",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-worker": "^30.3.0",
    "socket.io-client": "^4.8.4",
    "ts-jest": "^29.4.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
