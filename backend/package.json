    "@types/node": "^20.19.37",
    "@types/pg": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^8.55.0",
    "jest": "^30.3.0",
    "jest-worker": "^30.3.0",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
